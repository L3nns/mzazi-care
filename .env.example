# ---------------------------------------------------------------- database
DB_HOST=mysql
DB_PORT=3306
DB_NAME=mzazi_care
DB_USER=mzazi
DB_PASSWORD=change-this-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# ------------------------------------------------------------- application
PORT=4000
NODE_ENV=production
CORS_ORIGIN=http://localhost:4000
RATE_LIMIT=300

# Generate with:  openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# ------------------------------------------------------ recommender service
ML_SERVICE_URL=http://ml-service:8000
# Shared secret between Express and the Python service. Generate the same way.
ML_SERVICE_TOKEN=replace-with-another-long-random-string
ML_TIMEOUT_MS=8000
# Re-index and retrain only; a retrain takes ~20s on the seeded data.
ML_REBUILD_TIMEOUT_MS=300000

# Content encoder:  sbert | tfidf | auto
#   sbert  sentence embeddings - best quality, needs sentence-transformers
#   tfidf  TF-IDF + SVD        - light, no PyTorch, always available
#   auto   sbert when installed, otherwise tfidf
MZAZI_ENCODER=auto
# all-MiniLM-L6-v2 is the measured best (ml-service/benchmark_queries.py):
#   top-1 category on English / Kiswahili queries
#     all-MiniLM-L6-v2 + thesaurus + query boost         0.89 / 0.90
#     paraphrase-multilingual-MiniLM-L12-v2 + thesaurus  0.83 / 0.60
# The multilingual model was not trained on Swahili; Kiswahili queries are
# carried by the thesaurus in synonyms.py whichever model runs.
MZAZI_SBERT_MODEL=all-MiniLM-L6-v2

MZAZI_DATA_SOURCE=mysql
MZAZI_K=20
# Weight on the content component (Section 2.5.3).
#   auto  start at 1, follow the matrix density, and review against held-out
#         interactions at every retrain (recommended)
#   0..1  a fixed value
MZAZI_ALPHA=auto
MZAZI_ALPHA_FLOOR=0.3
MZAZI_DENSITY_TARGET=10
MZAZI_MIN_INTERACTIONS=3
# Below this cosine similarity nothing "matches" and the engine shows popular,
# highly rated services instead (Table 4.3). auto = 0.25 for sentence
# embeddings, 0.10 for TF-IDF+SVD (the two encoders score on different scales).
MZAZI_MIN_SIMILARITY=auto
# Share of the list kept for highly rated services in related categories
# while the collaborative component is unavailable (Section 4.8.3).
MZAZI_DIVERSITY_SHARE=0.2
MZAZI_MODEL_PATH=/app/model/hybrid_model.joblib

# ------------------------------------------------------- provider uploads
# Supporting evidence and profile images (Figure 4.14).
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_BYTES=5242880
