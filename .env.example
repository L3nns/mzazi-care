# ---------------------------------------------------------------- database
DB_HOST=mysql
DB_PORT=3306
DB_NAME=mzazi_care
DB_USER=mzazi
DB_PASSWORD=change-this-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# ------------------------------------------------------------- application
PORT=4000
NODE_ENV=production
CORS_ORIGIN=http://localhost:4000
RATE_LIMIT=300
# Number of reverse proxies in front of the API (1 behind Caddy/nginx). Unset
# when the API is reached directly. Wrong either way breaks per-client rate limits.
#TRUST_PROXY=1
# Logs: json (one object per line, the production default) or pretty.
LOG_FORMAT=json
LOG_LEVEL=info

# Generate with:  openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h
# Encrypts two-step sign-in secrets at rest. Keep it when rotating JWT_SECRET,
# or every enrolled authenticator stops working. Generate the same way.
MFA_ENCRYPTION_KEY=replace-with-a-third-long-random-string
BCRYPT_ROUNDS=12

# ------------------------------------------------------ recommender service
ML_SERVICE_URL=http://ml-service:8000
# Shared secret between Express and the Python service. Generate the same way.
ML_SERVICE_TOKEN=replace-with-another-long-random-string
ML_TIMEOUT_MS=8000
# Re-index and retrain only; a retrain takes ~20s on the seeded data.
ML_REBUILD_TIMEOUT_MS=300000

# Content encoder:  sbert | tfidf | auto
#   sbert  sentence embeddings - best quality, needs sentence-transformers
#   tfidf  TF-IDF + SVD        - light, no PyTorch, always available
#   auto   sbert when installed, otherwise tfidf
MZAZI_ENCODER=auto
# all-MiniLM-L6-v2 is the measured best (ml-service/benchmark_queries.py):
#   top-1 category on English / Kiswahili queries
#     all-MiniLM-L6-v2 + thesaurus + query boost         0.89 / 0.90
#     paraphrase-multilingual-MiniLM-L12-v2 + thesaurus  0.83 / 0.60
# The multilingual model was not trained on Swahili; Kiswahili queries are
# carried by the thesaurus in synonyms.py whichever model runs.
MZAZI_SBERT_MODEL=all-MiniLM-L6-v2

MZAZI_DATA_SOURCE=mysql
MZAZI_K=20
# Weight on the content component (Section 2.5.3).
#   auto  start at 1, follow the matrix density, and review against held-out
#         interactions at every retrain (recommended)
#   0..1  a fixed value
MZAZI_ALPHA=auto
MZAZI_ALPHA_FLOOR=0.3
MZAZI_DENSITY_TARGET=10
MZAZI_MIN_INTERACTIONS=3
# Below this cosine similarity nothing "matches" and the engine shows popular,
# highly rated services instead (Table 4.3). auto = 0.25 for sentence
# embeddings, 0.10 for TF-IDF+SVD (the two encoders score on different scales).
MZAZI_MIN_SIMILARITY=auto
# Share of the list kept for highly rated services in related categories
# while the collaborative component is unavailable (Section 4.8.3).
MZAZI_DIVERSITY_SHARE=0.2
MZAZI_MODEL_PATH=/app/model/hybrid_model.joblib
# Ranking beyond the content/collaborative blend. Unset (auto): chosen on a
# validation split at every retrain; a number pins the weight.
#MZAZI_LOCATION_WEIGHT=
#MZAZI_QUALITY_WEIGHT=
# Diversity re-ranking (Maximal Marginal Relevance): unset = off, 1 = off,
# lower = more variety. Phase 6 measured a small gain (about 0.3 more
# categories per list) at a small cost in nDCG, so it stays off.
#MZAZI_MMR_LAMBDA=
# A retrained candidate serves only if its recall@10 is within this of the
# serving version's. false: an administrator always promotes by hand.
MZAZI_AUTO_PROMOTE=true
MZAZI_PROMOTE_TOLERANCE=0.01
# Search: free text is matched by meaning through the engine (semantic); with
# keyword, or whenever the engine is unreachable, by keyword SQL, which needs
# every word to appear (Phase 6: nothing found for 69% of real questions).
SEARCH_MODE=semantic
# How far an empty area search looks for nearby alternatives (km, between area
# centres), and how long "Not for me" hides a provider (days).
NEARBY_KM=6
FEEDBACK_HIDE_DAYS=180

# ------------------------------------------------------------------ map
# Place search on the map: the platform's own areas are matched first; other
# places are looked up with OpenStreetMap's Nominatim (one request a second,
# cached). off: only the platform's areas. Nominatim's policy asks for a
# contact in the User-Agent: set GEOCODER_CONTACT in production.
GEOCODER=nominatim
GEOCODER_CONTACT=
#NOMINATIM_URL=https://nominatim.openstreetmap.org

# --------------------------------------------------------- data retention
# Days before personal data is deleted by the daily job (backend/services/
# retention.js; by hand: npm run retention). 0 keeps it. The privacy notice
# (frontend/privacy.html) states these values: change both together.
SEARCH_RETENTION_DAYS=365
RECOMMENDATION_LOG_RETENTION_DAYS=90
FEEDBACK_RETENTION_DAYS=365
INTERACTION_RETENTION_DAYS=730
# Stored model files hold parents' activity; keep only the newest few.
MZAZI_KEEP_MODEL_FILES=3

# ------------------------------------------------------- provider uploads
# Supporting evidence and profile images (Figure 4.14).
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_BYTES=5242880
# Dashboard warning window for verification documents nearing expiry.
DOCUMENT_WARN_DAYS=30
